rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Replace the two emails with the real accounts created under
// Authentication → Users. Nobody else can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeam() {
      return request.auth != null
        && request.auth.token.email in [
          "admin@example.com",
          "shweta@example.com"
        ];
    }

    match /Indoor_Quote_App/{docId} {
      allow read, write: if isTeam();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
